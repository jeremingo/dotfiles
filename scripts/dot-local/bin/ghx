#!/usr/bin/env python3

import sys
import termios
import tty
import subprocess
import pprint
import string

def get_key():
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)

    try:
        tty.setraw(fd)
        return sys.stdin.read(1)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)

commands = {
        "d": "gh develop {issue}",
        "i": "gh issues",
        "m": "gh merge",
        "r": "gh review",
        "t": "gh todo",
        "p": "gh pr view",
        "w": "gh run watch",
        "c": "clear"
    }

def run_command(template):
    formatter = string.Formatter()
    fields = [
            field_name
            for _, field_name, _, _ in formatter.parse(template)
            if field_name
        ]

    values = { field: input(f"{field} > ") for field in fields }

    command = template.format(**values)

    subprocess.run(command.split(" "))

while True:
    print("> ", end="", flush=True)

    key = get_key()
    print(key)

    if key == "q":
        break

    if key == "?":
        pprint.pprint(commands)
        continue

    command = commands.get(key)

    if command:
        run_command(command)
    else:
        print(f"Unknown command: {key}. ? for help.")
